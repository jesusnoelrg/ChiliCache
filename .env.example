# Server
PORT=3000
MODE=dev
API_URL=http://localhost:3000
NODE_ENV=development

# Redis (local: docker compose up -d; production: Upstash)
# Paste ONLY the URL, without REDIS_URL= or quotes:
# REDIS_URL=rediss://default:YOUR_TOKEN@your-db.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Persistent data (SQLite + uploads)
# Local: ./data | Fly.io volume: /var/data
DATA_DIR=./data

# Optional: initial admin password when no admin exists (default: admin123)
# ADMIN_PASSWORD=change-me-on-first-deploy
