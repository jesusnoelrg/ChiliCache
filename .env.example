# Server
PORT=3000
MODE=dev
API_URL=http://localhost:3000
NODE_ENV=development

# Redis (local: docker compose up -d)
REDIS_URL=redis://localhost:6379

# Persistent data (SQLite + uploads). On Render set to the disk mount, e.g. /var/data
DATA_DIR=./data

# Optional: initial admin password used only when no admin exists yet (default: admin123)
# ADMIN_PASSWORD=change-me-on-first-deploy
