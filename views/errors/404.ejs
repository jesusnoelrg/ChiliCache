<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= company.name %> | Página no encontrada</title>
  <!--Bootstrap-->
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/bootstrap-icons.min.css">
  <!--CSS my styles-->
  <link rel="stylesheet" href="/css/general.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/variables.css">
  <style>
    :root {
      --color-primario: <%= company.primary_color %>;
      --color-secundario: <%= company.secondary_color %>
    }
  </style>
  <!--Logo-->
  <link rel="shortcut icon" href="<%= company.logo %>" type="image/x-icon">
</head>

<body class="bg-main d-flex justify-content-center align-items-center vh-100 m-0">
  <div class="container text-center">
    <div class="row justify-content-center">
      <div class="col-md-6 bg-white p-5 rounded-10 shadow-sm">
        <div class="mb-4">
          <i class="bi bi-exclamation-triangle-fill text-danger display-1"></i>
        </div>
        <h1 class="fw-bold fs-1 text-dark mb-2">404</h1>
        <h2 class="fw-bold fs-4 text-secondary mb-3">Página no encontrada</h2>
        <p class="text-gray mb-4">Lo sentimos, la página que estás buscando no existe, ha sido movida o la dirección es incorrecta.</p>
        <a href="/home" class="btn btn-dark px-4 py-2 rounded-10 text-decoration-none">
          <i class="bi bi-house-door-fill me-2"></i> Volver al inicio
        </a>
      </div>
    </div>
  </div>

  <!--JS-->
  <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>